  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings.typography.intro"
      },
      {
        "type": "text",
        "id": "font_display",
        "label": "t:settings.typography.display",
        "default": "Cormorant Garamond"
      },
      {
        "type": "text",
        "id": "font_body",
        "label": "t:settings.typography.body",
        "default": "Jost"
      },
      {
        "type": "text",
        "id": "font_mono",
        "label": "t:settings.typography.mono",
        "default": "IBM Plex Mono"
      },
      {
        "type": "checkbox",
        "id": "load_google_fonts",
        "label": "t:settings.typography.load_google",
        "info": "t:settings.typography.load_google_info",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_gutter",
        "min": 16,
        "max": 72,
        "step": 2,
        "unit": "px",
        "label": "t:settings.layout.gutter",
        "default": 44
      },
      {
        "type": "range",
        "id": "page_max_width",
        "min": 1200,
        "max": 2200,
        "step": 20,
        "unit": "px",
        "label": "t:settings.layout.max_width",
        "default": 1920
      },
      {
        "type": "select",
        "id": "corner_radius",
        "label": "t:settings.layout.radius",
        "options": [
          {
            "value": "0px",
            "label": "t:settings.layout.radius_none"
          },
          {
            "value": "2px",
            "label": "t:settings.layout.radius_hairline"
          },
          {
            "value": "6px",
            "label": "t:settings.layout.radius_soft"
          }
        ],
        "default": "0px"
      }
    ]
  },
  {
    "name": "t:settings.product_cards.name",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "t:settings.product_cards.ratio",
        "options": [
          {
            "value": "3 / 4",
            "label": "t:settings.product_cards.ratio_portrait"
          },
          {
            "value": "4 / 5",
            "label": "t:settings.product_cards.ratio_tall"
          },
          {
            "value": "1 / 1",
            "label": "t:settings.product_cards.ratio_square"
          }
