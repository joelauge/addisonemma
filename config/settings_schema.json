      {
        "type": "checkbox",
        "id": "card_hover_second_image",
        "label": "t:settings.product_cards.hover_image",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_wishlist",
        "label": "t:settings.product_cards.wishlist",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_quick_add",
        "label": "t:settings.product_cards.quick_add",
        "info": "t:settings.product_cards.quick_add_info",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor_line",
        "label": "t:settings.product_cards.material_line",
        "info": "t:settings.product_cards.material_line_info",
        "default": true
      }
    ]
  },
