{%- comment -%}
  Emits the column counts for a .product-grid as custom properties.

  All three live in the same inline style, so the responsive rules in
  base.css switch which property they read rather than trying to override an
  inline value — which they would always lose.

  Accepts: columns (desktop), mobile (optional, default 2)
{%- endcomment -%}
{%- liquid
  assign desktop = columns | default: 4 | times: 1
  if desktop < 1
    assign desktop = 1
  endif

  assign tablet = desktop
  if tablet > 3
    assign tablet = 3
  endif

  assign small = mobile | default: 2 | times: 1
  if small > desktop
    assign small = desktop
  endif
-%}
--cols: {{ desktop }}; --cols-tablet: {{ tablet }}; --cols-mobile: {{ small }};
