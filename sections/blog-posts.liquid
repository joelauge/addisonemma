{%- assign blog = section.settings.blog -%}

<section class="section page">
  <div class="section-head">
    <h2 class="section-head__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank and blog != blank -%}
      <a class="section-head__link" href="{{ blog.url }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>

  <div class="product-grid" style="{% render 'grid-style', columns: section.settings.columns, mobile: 1 %} padding-top: 42px;">
    {%- if blog.articles.size > 0 -%}
      {%- for article in blog.articles limit: section.settings.limit -%}
        <a class="journal-card" href="{{ article.url }}">
          <div class="media media--4-3" data-reveal>
            {%- if article.image -%}
                            {%- assign img_alt = article.image.alt | default: article.title | escape -%}
              {{
                article.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '300,450,600,900,1200',
                  sizes: '(min-width: 990px) 33vw, 90vw',
                  alt: img_alt,
                  class: 'media__img'
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder' }}
            {%- endif -%}
          </div>
          {%- if article.tags.size > 0 -%}
            <p class="kicker kicker--faint journal-card__kicker" style="color: var(--kicker);">{{ article.tags.first }}</p>
          {%- endif -%}
          <p class="journal-card__title">{{ article.title }}</p>
          {%- if section.settings.show_date -%}
            <p class="meta-line journal-card__date">{{ article.published_at | date: format: 'day_month_year' }}</p>
          {%- endif -%}
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.limit) -%}
        <div class="journal-card">
          <div class="media media--4-3">{{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder' }}</div>
          <p class="journal-card__title">{{ 'onboarding.article_title' | t }}</p>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "From the journal" },
    { "type": "blog", "id": "blog", "label": "t:sections.blog_posts.blog", "default": "news" },
    { "type": "text", "id": "link_label", "label": "t:sections.common.link_label", "default": "All entries" },
    { "type": "range", "id": "limit", "min": 2, "max": 9, "step": 1, "label": "t:sections.blog_posts.limit", "default": 3 },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.common.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "show_date", "label": "t:sections.blog_posts.show_date", "default": false }
  ],
  "presets": [{ "name": "t:sections.blog_posts.name" }]
}
{% endschema %}
