<section style="display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); gap: 4px; padding-bottom: 104px;">
  {%- for block in section.blocks -%}
    <div class="media media--4-5" {{ block.shopify_attributes }} data-reveal>
      {%- if block.settings.image -%}
                {%- assign img_alt = block.settings.image.alt | default: block.settings.caption | escape -%}
        {{
          block.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '400,600,800,1000,1200',
            sizes: '(min-width: 750px) 33vw, 100vw',
            alt: img_alt,
            class: 'media__img'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'media__placeholder' }}
      {%- endif -%}
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "t:sections.image_trio.name",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "t:sections.common.image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.common.image" },
        { "type": "text", "id": "caption", "label": "t:sections.image_trio.caption" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.image_trio.name",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
