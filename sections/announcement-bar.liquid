<div class="announcement">
  {%- if section.settings.message != blank -%}
    <span>{{ section.settings.message }}</span>
  {%- endif -%}
  {%- if section.settings.message != blank and section.settings.link_label != blank -%}
    <span class="announcement__divider" aria-hidden="true">&mdash;</span>
  {%- endif -%}
  {%- if section.settings.link_label != blank -%}
    <a href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.announcement.name",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "t:sections.announcement.message",
      "default": "Complimentary shipping, insured"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.announcement.link_label",
      "default": "Private appointments"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement.link"
    }
  ]
}
{% endschema %}
