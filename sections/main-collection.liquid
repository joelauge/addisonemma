{%- liquid
  assign page_size = section.settings.page_size
  assign columns = section.settings.columns
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

<div class="page">
  <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb.label' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
    /
    <span class="breadcrumb__current">{{ collection.title }}</span>
  </nav>

  <header class="collection-head">
    <div>
      {%- if section.settings.kicker != blank -%}
        <p class="kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      <h1 class="display display--l" tabindex="-1" data-facet-heading style="margin-top: 18px;">
        {{ collection.title }}
      </h1>
    </div>
    {%- if collection.description != blank -%}
      <div class="collection-head__text">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  <facet-form data-section-id="{{ section.id }}">
    <form id="FacetForm-{{ section.id }}">
      <div class="collection-bar">
        <div class="collection-bar__filters" data-facet-controls>
          {%- if section.settings.show_filters and collection.filters.size > 0 -%}
            {%- assign has_active = false -%}
            {%- for filter in collection.filters -%}
              {%- if filter.active_values.size > 0 -%}{%- assign has_active = true -%}{%- endif -%}
            {%- endfor -%}

            <a
              class="pill"
              href="{{ collection.url }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by }}{% endif %}"
              data-facet-link
              aria-current="{% if has_active %}false{% else %}true{% endif %}"
            >
              {{ 'collections.filters.all' | t }}
            </a>

            {%- for filter in collection.filters -%}
              {%- if filter.type == 'list' -%}
                {%- for value in filter.values -%}
                  {%- if value.count > 0 or value.active -%}
                    <a
                      class="pill"
                      href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                      data-facet-link
                      aria-current="{{ value.active }}"
                    >
                      {{ value.label }}
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="collection-bar__right">
          <span class="collection-count" data-collection-count>
            {{ 'collections.showing' | t: count: collection.products_count }}
          </span>

          {%- if section.settings.show_sort -%}
            <label class="visually-hidden" for="SortBy">{{ 'collections.sort.label' | t }}</label>
            <select class="select-bare" id="SortBy" name="sort_by">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                  {{ 'collections.sort.prefix' | t }} &mdash; {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
          {%- endif -%}
        </div>
      </div>
    </form>

    <div data-facet-target>
      {%- paginate collection.products by page_size -%}
        {%- if collection.products.size > 0 -%}
          <div class="product-grid product-grid--roomy" style="{% render 'grid-style', columns: columns %} padding: 44px 0 30px;">
            {%- for product in collection.products -%}
              {%
                render 'product-card',
                card_product: product,
                show_badge: true,
                reveal: true,
                sizes: '(min-width: 990px) 33vw, 50vw'
              %}
            {%- endfor -%}
          </div>

          {%- assign shown_count = paginate.current_offset | plus: collection.products.size -%}
          <div class="collection-foot">
            <span class="collection-count">
              {{ 'collections.showing_of' | t: shown: shown_count, total: paginate.items }}
            </span>

            {%- if paginate.next -%}
              <load-more
                data-section-id="{{ section.id }}"
                data-next-url="{{ paginate.next.url }}"
                data-loading-label="{{ 'collections.loading' | t }}"
              >
                <button class="btn btn--ghost" type="button">{{ 'collections.load_more' | t }}</button>
              </load-more>

              {%- comment -%} The real link, for crawlers and for no-JS. {%- endcomment -%}
              <noscript>
                <a class="btn btn--ghost" href="{{ paginate.next.url }}">{{ 'collections.next_page' | t }}</a>
              </noscript>
            {%- else -%}
              <p class="collection-count">{{ 'collections.thats_all' | t }}</p>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="collection-empty">
            <p class="collection-empty__title">{{ 'collections.empty_title' | t }}</p>
            <p class="prose" style="max-width: 420px; margin: 14px auto 0;">{{ 'collections.empty_body' | t }}</p>
            <a class="link-rule" href="{{ routes.all_products_collection_url }}" style="margin-top: 26px;">
              {{ 'collections.empty_cta' | t }}
            </a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </facet-form>
</div>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "t:sections.common.kicker", "default": "Autumn — Winter 2026" },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.common.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "range", "id": "page_size", "min": 6, "max": 36, "step": 3, "label": "t:sections.main_collection.page_size", "default": 9 },
    { "type": "checkbox", "id": "show_filters", "label": "t:sections.main_collection.show_filters", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "t:sections.main_collection.show_sort", "default": true }
  ]
}
{% endschema %}
