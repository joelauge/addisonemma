<section class="section page statement" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.show_rule -%}
    <div class="statement__rule" data-reveal-rule></div>
  {%- endif -%}

  {%- if section.settings.body != blank -%}
    <div class="lede {% if section.settings.italic %}lede--italic{% endif %} statement__body" data-reveal>
      {{ section.settings.body }}
    </div>
  {%- endif -%}

  {%- if section.settings.attribution != blank -%}
    <p class="statement__attribution">{{ section.settings.attribution }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.statement.name",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_rule", "label": "t:sections.statement.show_rule", "default": true },
    { "type": "checkbox", "id": "italic", "label": "t:sections.statement.italic", "default": true },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.statement.body",
      "default": "<p>Clothes for the hours that are not accounted for — the walk before lunch, the long train south, the second bottle opened on the terrace at five.</p>"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "t:sections.statement.attribution",
      "default": "Addison Emma — Aveyron, France"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "t:sections.common.padding_top", "default": 112 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "t:sections.common.padding_bottom", "default": 96 }
  ],
  "presets": [{ "name": "t:sections.statement.name" }]
}
{% endschema %}
