<div class="page" style="display: grid; justify-items: center; text-align: center; padding-block: clamp(80px, 14vw, 180px);">
  <p class="kicker">{{ 'general.404.kicker' | t }}</p>
  <h1 class="display display--l" style="margin-top: 20px; max-width: 720px;">{{ 'general.404.title' | t }}</h1>
  <p class="prose" style="max-width: 460px; margin-top: 18px;">{{ 'general.404.body' | t }}</p>
  <div style="display: flex; gap: 30px; margin-top: 36px; flex-wrap: wrap; justify-content: center;">
    <a class="link-rule" href="{{ routes.all_products_collection_url }}">{{ 'general.404.cta_collection' | t }}</a>
    <a class="link-rule" href="{{ routes.root_url }}">{{ 'general.404.cta_home' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "settings": []
}
{% endschema %}
