<footer class="footer" role="contentinfo">
  <div class="footer__grid">
    <div>
      {%- if section.settings.logo -%}
                {%- assign img_alt = shop.name | escape -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag: loading: 'lazy', widths: '150,200,300,400', sizes: '200px', alt: img_alt, style: 'width:200px'
        }}
      {%- else -%}
        <p class="footer__wordmark">{{ shop.name }}</p>
      {%- endif -%}

      {%- if section.settings.address != blank -%}
        <div class="footer__address">{{ section.settings.address }}</div>
      {%- endif -%}

      {%- if section.settings.telephone != blank -%}
        <p class="footer__phone meta-line">
          <a href="tel:{{ section.settings.telephone | remove: ' ' }}">{{ section.settings.telephone }}</a>
        </p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'menu' -%}
        <nav class="footer__column" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <p class="footer__column-heading">{{ block.settings.heading }}</p>
          {%- endif -%}
          {%- for link in block.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </nav>
      {%- elsif block.type == 'text' -%}
        <div class="footer__column" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <p class="footer__column-heading">{{ block.settings.heading }}</p>
          {%- endif -%}
          <div class="prose" style="font-size: 13px; line-height: 1.8; color: var(--muted);">
            {{ block.settings.body }}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="footer__base">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>

    {%- if section.settings.show_locale_selector and localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      <form method="post" action="{{ routes.root_url }}localization" id="FooterLocalization" accept-charset="UTF-8" class="no-prefetch">
        <input type="hidden" name="form_type" value="localization">
        <input type="hidden" name="_method" value="put">
        <input type="hidden" name="return_to" value="{{ request.path }}">
        <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
          {%- if localization.available_countries.size > 1 -%}
            <label class="visually-hidden" for="FooterCountry">{{ 'general.localization.country' | t }}</label>
            <select class="select-bare" id="FooterCountry" name="country_code" onchange="this.form.submit()">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                  {{ country.name }} ({{ country.currency.iso_code }})
                </option>
              {%- endfor -%}
            </select>
          {%- endif -%}
          {%- if localization.available_languages.size > 1 -%}
            <label class="visually-hidden" for="FooterLanguage">{{ 'general.localization.language' | t }}</label>
            <select class="select-bare" id="FooterLanguage" name="locale_code" onchange="this.form.submit()">
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                  {{ language.endonym_name }}
                </option>
              {%- endfor -%}
            </select>
          {%- endif -%}
        </div>
      </form>
    {%- elsif section.settings.locale_line != blank -%}
      <span>{{ section.settings.locale_line }}</span>
    {%- endif -%}

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div class="footer__payment">
        <span class="visually-hidden">{{ 'general.payment.accepted' | t }}</span>
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "t:sections.footer.logo" },
    {
      "type": "richtext",
      "id": "address",
      "label": "t:sections.footer.address",
      "default": "<p>14 rue des Tanneurs, Saint-Côme-d'Olt, Aveyron. Open Tuesday to Saturday, by appointment.</p>"
    },
    { "type": "text", "id": "telephone", "label": "t:sections.footer.telephone", "default": "+33 5 65 44 00 12" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:sections.footer.payment_icons", "default": true },
    { "type": "checkbox", "id": "show_locale_selector", "label": "t:sections.footer.locale_selector", "default": true },
    { "type": "text", "id": "locale_line", "label": "t:sections.footer.locale_line", "default": "France — English — EUR" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.blocks.heading", "default": "The house" },
        { "type": "link_list", "id": "menu", "label": "t:sections.footer.blocks.menu_label", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.blocks.heading" },
        { "type": "richtext", "id": "body", "label": "t:sections.footer.blocks.body" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [{ "type": "menu" }, { "type": "menu" }, { "type": "menu" }]
    }
  ]
}
{% endschema %}
