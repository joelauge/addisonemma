{%- liquid
  assign products = section.settings.collection.products
  assign limit = section.settings.limit
  assign columns = section.settings.columns
-%}

<section class="section page" style="padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="section-head">
    <h2 class="section-head__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.link_label != blank and section.settings.collection != blank -%}
      <a class="section-head__link" href="{{ section.settings.collection.url }}">
        {{- section.settings.link_label -}}
      </a>
    {%- endif -%}
  </div>

  <div class="product-grid" style="{% render 'grid-style', columns: columns %} padding-top: 42px;">
    {%- if products.size > 0 -%}
      {%- for product in products limit: limit -%}
        {%
          render 'product-card',
          card_product: product,
          show_badge: true,
          reveal: true,
          sizes: '(min-width: 990px) calc(100vw / 4), (min-width: 750px) 33vw, 50vw'
        %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..limit) -%}
        <div class="card">
          <div class="media media--ratio-card card__media">
            {{ 'product-1' | placeholder_svg_tag: 'media__placeholder' }}
          </div>
          <div class="card__body">
            <div class="card__title">{{ 'onboarding.product_title' | t }}</div>
            <div class="card__price">{{ 1980 | money }}</div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "Selected pieces" },
    { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.collection" },
    { "type": "text", "id": "link_label", "label": "t:sections.common.link_label", "default": "View the whole collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "label": "t:sections.featured_collection.limit", "default": 4 },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.common.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "t:sections.common.padding_bottom", "default": 112 }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
