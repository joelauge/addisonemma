<div class="page" style="max-width: 460px; margin-inline: auto; padding-block: clamp(60px, 10vw, 120px);">
  <h1 class="display display--m">{{ 'customer.login.title' | t }}</h1>

  <div id="RecoverPassword" style="display: none;">
    {%- form 'recover_customer_password', class: 'form-stack', style: 'margin-top: 28px;' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-banner" tabindex="-1" data-form-success>{{ 'customer.recover.success' | t }}</p>
      {%- endif -%}
      <p class="prose">{{ 'customer.recover.body' | t }}</p>
      <label class="field">
        <span class="field__label">{{ 'customer.fields.email' | t }}</span>
        <input class="field__input" type="email" name="email" autocomplete="email" required>
      </label>
      <button class="btn" type="submit">{{ 'customer.recover.submit' | t }}</button>
      <button class="plain-button link-rule" type="button" onclick="document.getElementById('RecoverPassword').style.display='none';document.getElementById('LoginForm').style.display='block';">
        {{ 'customer.recover.cancel' | t }}
      </button>
    {%- endform -%}
  </div>

  <div id="LoginForm">
    {%- form 'customer_login', class: 'form-stack', style: 'margin-top: 28px;' -%}
      {%- if form.errors -%}
        <p class="form-banner form-banner--error" tabindex="-1" data-form-error>{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <label class="field">
        <span class="field__label">{{ 'customer.fields.email' | t }}</span>
        <input class="field__input" type="email" name="customer[email]" autocomplete="email" required>
      </label>

      <label class="field">
        <span class="field__label">{{ 'customer.fields.password' | t }}</span>
        <input class="field__input" type="password" name="customer[password]" autocomplete="current-password" required>
      </label>

      <button class="btn" type="submit">{{ 'customer.login.submit' | t }}</button>

      <button class="plain-button link-rule" type="button" style="justify-self: start;" onclick="document.getElementById('LoginForm').style.display='none';document.getElementById('RecoverPassword').style.display='block';">
        {{ 'customer.login.forgot' | t }}
      </button>
    {%- endform -%}

    <p class="prose" style="margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--rule);">
      {{ 'customer.login.no_account' | t }}
      <a href="{{ routes.account_register_url }}">{{ 'customer.register.title' | t }}</a>
    </p>
  </div>
</div>

{% schema %}
{ "name": "t:sections.customers.login", "tag": "section", "settings": [] }
{% endschema %}
