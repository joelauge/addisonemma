<div class="page" style="max-width: 460px; margin-inline: auto; padding-block: clamp(60px, 10vw, 120px);">
  <h1 class="display display--m">{{ 'customer.register.title' | t }}</h1>
  <p class="prose" style="margin-top: 14px;">{{ 'customer.register.body' | t }}</p>

  {%- form 'create_customer', class: 'form-stack', style: 'margin-top: 28px;' -%}
    {%- if form.errors -%}
      <p class="form-banner form-banner--error" tabindex="-1" data-form-error>{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <label class="field">
      <span class="field__label">{{ 'customer.fields.first_name' | t }}</span>
      <input class="field__input" type="text" name="customer[first_name]" autocomplete="given-name">
    </label>
    <label class="field">
      <span class="field__label">{{ 'customer.fields.last_name' | t }}</span>
      <input class="field__input" type="text" name="customer[last_name]" autocomplete="family-name">
    </label>
    <label class="field">
      <span class="field__label">{{ 'customer.fields.email' | t }}</span>
      <input class="field__input" type="email" name="customer[email]" autocomplete="email" required>
    </label>
    <label class="field">
      <span class="field__label">{{ 'customer.fields.password' | t }}</span>
      <input class="field__input" type="password" name="customer[password]" autocomplete="new-password" required>
    </label>

    <button class="btn" type="submit">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}

  <p class="prose" style="margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--rule);">
    {{ 'customer.register.have_account' | t }}
    <a href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a>
  </p>
</div>

{% schema %}
{ "name": "t:sections.customers.register", "tag": "section", "settings": [] }
{% endschema %}
