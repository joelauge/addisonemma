<section class="split {% if section.settings.media_position == 'right' %}split--reverse{% endif %}">
  <div class="split__media">
    {%- if section.settings.image -%}
            {%- assign img_alt = section.settings.image.alt | default: section.settings.heading | escape -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          loading: 'lazy',
          widths: '600,800,1000,1200,1600',
          sizes: '(min-width: 990px) 52vw, 100vw',
          alt: img_alt,
          class: 'media__img'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'media__placeholder' }}
    {%- endif -%}
  </div>

  <div class="split__body">
    {%- if section.settings.kicker != blank -%}
      <p class="kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="display display--m split__title" data-reveal>{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="prose split__text">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- assign stats = section.blocks | where: 'type', 'stat' -%}
    {%- if stats.size > 0 -%}
      <div class="split__stats">
        {%- for block in stats -%}
          <div {{ block.shopify_attributes }}>
            <div class="split__stat-figure">{{ block.settings.figure }}</div>
            <div class="split__stat-label">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a class="link-rule split__cta" href="{{ section.settings.cta_link | default: routes.root_url }}">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.split_feature.name",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.common.image" },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:sections.split_feature.media_position",
      "options": [
        { "value": "left", "label": "t:sections.split_feature.left" },
        { "value": "right", "label": "t:sections.split_feature.right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "kicker", "label": "t:sections.common.kicker", "default": "Savoir-faire" },
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "Four hands, eleven days, one coat" },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.common.body",
      "default": "<p>Every outer piece leaves our workroom in the Aveyron with the initials of the two tailors who made it stitched inside the left facing. We cut from a single roll each season; when the roll is finished, the coat is finished.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "t:sections.common.link_label", "default": "Inside the atelier" },
    { "type": "url", "id": "cta_link", "label": "t:sections.common.link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:sections.split_feature.blocks.stat",
      "settings": [
        { "type": "text", "id": "figure", "label": "t:sections.split_feature.blocks.figure", "default": "118" },
        { "type": "text", "id": "label", "label": "t:sections.split_feature.blocks.label", "default": "years in the valley" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "t:sections.split_feature.name",
      "blocks": [{ "type": "stat" }, { "type": "stat" }]
    }
  ]
}
{% endschema %}
