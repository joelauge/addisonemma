<div style="min-height: 100dvh; display: grid; grid-template-columns: 1.1fr 1fr;">
  <div class="media" style="border-radius: 0;">
    {%- if section.settings.image -%}
            {%- assign img_alt = shop.name | escape -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600,900,1200,1600,2000',
          sizes: '55vw',
          alt: img_alt,
          class: 'media__img'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'media__placeholder' }}
    {%- endif -%}
  </div>

  <div style="display: flex; flex-direction: column; justify-content: center; padding: clamp(40px, 6vw, 90px);">
    <p class="header__wordmark" style="padding-left: 0;">{{ shop.name }}</p>
    {%- if settings.brand_established != blank -%}
      <p class="header__established" style="padding-left: 0;">{{ settings.brand_established }}</p>
    {%- endif -%}

    <h1 class="display display--m" style="margin-top: 40px;">{{ section.settings.heading }}</h1>
    {%- if section.settings.body != blank -%}
      <div class="prose" style="margin-top: 18px; max-width: 420px;">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'form-stack', style: 'margin-top: 34px; max-width: 380px;' -%}
      {%- if form.errors -%}
        <p class="form-banner form-banner--error" tabindex="-1" data-form-error>
          {{ 'general.password.error' | t }}
        </p>
      {%- endif -%}
      <label class="field">
        <span class="field__label">{{ 'general.password.label' | t }}</span>
        <input class="field__input" type="password" name="password" autocomplete="current-password" required autofocus>
      </label>
      <button class="btn" type="submit">{{ 'general.password.submit' | t }}</button>
    {%- endform -%}

    <div style="margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--rule);">
      {%- form 'customer', id: 'PasswordNewsletter', class: 'form-stack' -%}
        <input type="hidden" name="contact[tags]" value="prospect, password page">
        {%- if form.posted_successfully? -%}
          <p class="meta-line" tabindex="-1" data-form-success>{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <p class="kicker kicker--faint">{{ section.settings.newsletter_heading }}</p>
          <div style="display: flex; border-bottom: 1px solid var(--rule-strong); max-width: 380px;">
            <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
            <input class="field__input" id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" style="border: 0;" required>
            <button class="plain-button" type="submit" style="padding: 8px 2px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; white-space: nowrap;">
              {{ 'newsletter.submit' | t }}
            </button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.common.image" },
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "Opening shortly" },
    { "type": "richtext", "id": "body", "label": "t:sections.common.body", "default": "<p>The house is being made ready. Leave your address and we will write to you the morning it opens.</p>" },
    { "type": "text", "id": "newsletter_heading", "label": "t:sections.main_password.newsletter_heading", "default": "Be told first" }
  ]
}
{% endschema %}
