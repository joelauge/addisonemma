<div class="page">
  <header style="padding: 66px 0 26px; border-bottom: 1px solid var(--rule);">
    {%- if section.settings.kicker != blank -%}
      <p class="kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}
    <h1 class="display display--l" style="margin-top: 18px;">{{ section.settings.heading }}</h1>
  </header>

  <div class="product-grid" style="{% render 'grid-style', columns: section.settings.columns %} padding: 44px 0 104px;">
    {%- for collection in collections -%}
      <a class="card" href="{{ collection.url }}" data-reveal>
        <div class="media media--4-5 card__media">
          {%- if collection.featured_image -%}
                        {%- assign img_alt = collection.featured_image.alt | default: collection.title | escape -%}
            {{
              collection.featured_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '300,450,600,900,1200',
                sizes: '(min-width: 990px) 33vw, 50vw',
                alt: img_alt,
                class: 'media__img card__img'
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'media__placeholder' }}
          {%- endif -%}
        </div>
        <div class="card__body">
          <div class="card__title" style="font-size: 26px;">{{ collection.title }}</div>
          <div class="card__price">{{ 'collections.count' | t: count: collection.all_products_count }}</div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "t:sections.common.kicker", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "Everything we make" },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.common.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ]
}
{% endschema %}
