{%- comment -%}
  A home for app blocks, so merchants can add one without editing Liquid.
{%- endcomment -%}
<section class="section page" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "t:sections.common.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "t:sections.common.padding_bottom", "default": 40 }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "t:sections.apps.name" }]
}
{% endschema %}
