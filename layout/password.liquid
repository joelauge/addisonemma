<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.colour_paper }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }} &ndash; {{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon_image -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon_image | image_url: width: 96 }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {%- if settings.load_google_fonts -%}
      {%- liquid
        assign f_display = settings.font_display | replace: ' ', '+'
        assign f_body = settings.font_body | replace: ' ', '+'
        assign f_mono = settings.font_mono | replace: ' ', '+'
        capture google_href
          echo 'https://fonts.googleapis.com/css2?family=' | append: f_display | append: ':ital,wght@0,300;0,400;1,300&family=' | append: f_body | append: ':wght@300;400&family=' | append: f_mono | append: ':wght@400&display=swap'
        endcapture
      -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="{{ google_href }}">
    {%- endif -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="template--password">
    <main>{{ content_for_layout }}</main>
    {{ powered_by_link }}
  </body>
</html>
