<!doctype html>
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  {% if settings.motion_view_transitions %}data-view-transitions="true"{% endif %}
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.colour_paper }}">
    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.load_google_fonts -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- endif -%}

    {%- if settings.favicon_image -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon_image | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon_image | image_url: width: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags.first }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {%- if settings.load_google_fonts -%}
      {%- liquid
        assign f_display = settings.font_display | replace: ' ', '+'
        assign f_body = settings.font_body | replace: ' ', '+'
        assign f_mono = settings.font_mono | replace: ' ', '+'
        capture google_href
          echo 'https://fonts.googleapis.com/css2?family=' | append: f_display | append: ':ital,wght@0,300;0,400;0,500;1,300;1,400&family=' | append: f_body | append: ':wght@300;400;500&family=' | append: f_mono | append: ':wght@400&display=swap'
        endcapture
      -%}
      {%- comment -%}
        Loaded async via the print-media swap so the faces never block first
        paint. Turn off "Load these from Google Fonts" in theme settings to
        serve the faces from Shopify's CDN instead.
      {%- endcomment -%}
      <link rel="stylesheet" href="{{ google_href }}" media="print" onload="this.media='all'">
      <noscript><link rel="stylesheet" href="{{ google_href }}"></noscript>
    {%- endif -%}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          search: {{ routes.search_url | json }},
          productRecommendations: {{ routes.product_recommendations_url | json }}
        },
        settings: {
          cartDrawer: {{ settings.cart_drawer | json }},
          wishlist: {{ settings.enable_wishlist | json }},
          wishlistDays: {{ settings.wishlist_days | json }},
          recentlyViewed: {{ settings.enable_recently_viewed | json }},
          reveals: {{ settings.motion_reveals | json }},
          moneyFormat: {{ shop.money_format | json }}
        },
        strings: {
          addedToBag: {{ 'cart.toast.added' | t | json }},
          removedFromBag: {{ 'cart.toast.removed' | t | json }},
          saved: {{ 'wishlist.toast.saved' | t: days: settings.wishlist_days | json }},
          unsaved: {{ 'wishlist.toast.removed' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          addToBag: {{ 'products.product.add_to_bag' | t | json }},
          error: {{ 'general.errors.generic' | t | json }},
          quantityError: {{ 'cart.errors.quantity' | t | json }},
          close: {{ 'general.actions.close' | t | json }}
        }
      };
    </script>

    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {%- if settings.motion_prefetch -%}
      {%- comment -%}
        Prefetch on hover. The link the visitor is reaching for is already
        halfway home by the time they click it.
      {%- endcomment -%}
      <script type="speculationrules">
        {
          "prefetch": [
            {
              "where": {
                "and": [
                  { "href_matches": "/*" },
                  { "not": { "href_matches": "/cart*" } },
                  { "not": { "href_matches": "/checkouts/*" } },
                  { "not": { "href_matches": "/account*" } },
                  { "not": { "selector_matches": ".no-prefetch, [rel~=nofollow]" } }
                ]
              },
              "eagerness": "moderate"
            }
          ]
        }
      </script>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body
    class="template--{{ request.page_type | handle }}"
    data-template="{{ template.name }}"
  >
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_drawer -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if settings.predictive_search -%}
      {% render 'search-panel' %}
    {%- endif -%}

    {%- comment -%}
      One live region for the whole site. Screen readers hear every add,
      every save, every removal — exactly once.
    {%- endcomment -%}
    <toast-shelf class="toast-shelf" role="status" aria-live="polite" aria-atomic="false"></toast-shelf>

    <div id="ModalPortal"></div>

    <ul hidden>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>
  </body>
</html>
